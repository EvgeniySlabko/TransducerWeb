        "dotenv": "^16.3.1",
        "electron-squirrel-startup": "^1.0.0",
        "express": "^4.18.2",
        "file-loader": "^6.2.0",
        "fili": "^2.0.3",
        "html2canvas": "^1.4.1",
        "next-pwa": "^5.6.0",
        "npm": "^8.19.4",
        "patch-package": "^6.5.1",
        "process": "^0.11.10",
        "queue-typescript": "^1.0.1",
        "react": "^18.2.0",
        "react-colorful": "^5.6.1",
        "react-dom": "^18.2.0",
        "react-redux": "^8.1.2",
        "react-switch-case": "^1.5.1",
        "redux": "^4.2.1",
        "redux-persist": "^6.0.0",
        "redux-persist-transform-filter": "^0.0.22",
