        "style-loader": "^3.3.3",
        "ts-loader": "^9.4.4",
        "typescript": "^4.9.5",
        "webpack": "^5.88.2",
        "webpack-cli": "^4.10.0",
        "webpack-dev-server": "^4.15.1",
        "webpack-merge": "^5.9.0",
        "workbox-webpack-plugin": "^6.6.0"
    },
    "engines": {
        "node": ">=8.11.2"
    },
    "license": "MIT",
    "snyk": true
}
