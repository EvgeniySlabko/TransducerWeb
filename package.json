        "usb": "^2.10.0",
        "util": "^0.12.5",
        "uuidv4": "^6.2.13"
    },
    "scripts": {
        "electron": "cross-env ENV=ELECTRON SOURCE=http://localhost:8080/ concurrently --kill-others \"electron ./index.js\" \"cross-env ENV=ELECTRON DIST=dist webpack serve --config webpack.dev.js\"",
        "electron-build": "cross-env SOURCE=dist/index.html electron-builder pack",
        "build:web": "cross-env ENV=WEB DIST=dist cross-env npx webpack-cli build --config webpack.prod.js",
        "build:electron": "cross-env ENV=ELECTRON DIST=dist cross-env npx webpack-cli build --config webpack.prod.js",
        "start": "cross-env ENV=WEB DIST=dist webpack serve --config webpack.dev.js",
        "server": "cross-env ENV=WEB SOURCE=dist/index.html node server.js",
        "tslint": "tslint --project tsconfig.json",
        "startProd": "webpack serve --open --config webpack.prod.js",

        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "lint": "echo \"No linting configured\"",

        "snyk-protect": "snyk protect",
        "prepublish": "npm run snyk-protect",
        "postinstall": "npx patch-package",
        "dep": "depcheck"
    },
    "devDependencies": {
        "@babel/cli": "^7.23.0",
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.22.20",
        "@electron-forge/cli": "^6.4.2",
        "@electron-forge/maker-deb": "^6.4.2",
        "@electron-forge/maker-rpm": "^6.4.2",
        "@electron-forge/maker-squirrel": "^6.4.2",
        "@electron-forge/maker-zip": "^6.4.2",
        "@electron-forge/plugin-auto-unpack-natives": "^6.4.2",
        "@types/electron": "^1.6.10",
        "@types/react": "^18.2.20",
        "@types/react-dom": "^18.2.7",
        "@types/react-switch-case": "^1.5.1",
        "@types/w3c-web-usb": "^1.0.6",
        "concurrently": "^8.2.1",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.8.1",
        "electron": "^26.2.2",
        "electron-builder": "^24.6.4",
        "html-webpack-plugin": "^5.5.3",
        "mini-css-extract-plugin": "^2.7.6",
        "node-sass": "^9.0.0",
        "postcss": "^8.4.29",
